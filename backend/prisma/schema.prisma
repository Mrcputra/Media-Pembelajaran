generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Materi {
  id        Int      @id @default(autoincrement())
  image     String?
  judul     String
  deskripsi String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
